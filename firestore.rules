rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPrimaryAdmin() {
      return isSignedIn() && request.auth.token.email == 'monikaverma25595@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidAccount(data) {
      return data.keys().hasAll([
        'ownerUid',
        'fullName',
        'countryCode',
        'maskedPhone',
        'verified',
        'credentialStatus',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerUid',
        'fullName',
        'countryCode',
        'phoneNumber',
        'maskedPhone',
        'verified',
        'enteredOtp',
        'credentialStatus',
        'createdAt',
        'updatedAt'
      ])
      && data.ownerUid is string
      && data.ownerUid.size() >= 1
      && data.ownerUid.size() <= 128
      && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.fullName is string
      && data.fullName.size() >= 2
      && data.fullName.size() <= 80
      && data.countryCode is string
      && data.countryCode in ['+91', '+1', '+44', '+971', '+65']
      && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() >= 10 && data.phoneNumber.size() <= 24))
      && data.maskedPhone is string
      && data.maskedPhone.size() >= 6
      && data.maskedPhone.size() <= 24
      && data.verified is bool
      && (!('enteredOtp' in data) || (data.enteredOtp is string && data.enteredOtp.size() <= 6 && data.enteredOtp.matches('^[0-9]*$')))
      && data.credentialStatus is string
      && data.credentialStatus == 'Protected'
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && (isOwner(accountId) || isAdmin());
      allow list: if isPrimaryAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create: if isValidId(accountId)
        && isOwner(accountId)
        && isValidAccount(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(accountId)
        && isValidAccount(incoming())
        && (
          isAdmin()
          || (
            isOwner(accountId)
            && incoming().ownerUid == existing().ownerUid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'countryCode',
              'phoneNumber',
              'maskedPhone',
              'verified',
              'enteredOtp',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(accountId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create, update, delete: if false;
    }
  }
}
